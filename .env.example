# =============================================================================
# Talon — .env.example
# =============================================================================
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# For production, use a secrets manager instead of plaintext .env:
#   docker compose --env-file secrets.env up -d --build
#
# Every var marked (required) has no fallback — compose refuses to start
# without it.
# =============================================================================

# ---- Timezone (all services) ----
TZ=UTC

# =============================================================================
# Metasploit RPC (talon-strike, kali-msf)
# =============================================================================
MSF_PASSWORD=change-me-to-a-real-password        # (required)
MSF_PORT=5554
MSF_SSL=true
# MSF_SERVER=localhost  # when running host-side binaries against compose MSF

# =============================================================================
# Reverse payload defaults (strike injects if agent omits them)
# =============================================================================
LHOST=127.0.0.1
LPORT=4444

# =============================================================================
# Talon Arsenal Engine
# =============================================================================
HEXSTRIKE_PORT=8888
TTYD_PORT=7681

# =============================================================================
# RabbitMQ (talon-relay)
# =============================================================================
RABBITMQ_USER=talon
RABBITMQ_PASSWORD=change-me-to-a-real-password   # (required)
AMQP_URL=********************************************************/  # (required)
# RABBITMQ_VHOST=/
# RABBITMQ_HOSTNAME=talon-rabbitmq

# =============================================================================
# Redis cache (health probes, AI analysis, session lookups)
# =============================================================================
REDIS_PORT=6380              # 6379 intentionally avoided (commonly taken)
REDIS_PASSWORD=change-me-to-a-real-password   # (required)
# REDIS_MAXMEMORY=200mb
# REDIS_LOGLEVEL=notice
# Core runs uncached when Redis is down; nothing breaks.

# =============================================================================
# Postgres (run history, auth sessions, runtime config)
# =============================================================================
TALON_PG_PASSWORD=change-me-to-a-real-password          # (required)
# PG_SSLMODE=?sslmode=disable    # prod: ?sslmode=require (needs DB cert)
# PG_SHARED_BUFFERS=128MB        # set to 25% of RAM
# PG_MAX_CONNECTIONS=100
# PG_EFFECTIVE_CACHE_SIZE=384MB
# PG_WORK_MEM=4MB
# PG_MAINTENANCE_WORK_MEM=64MB
# PG_SLOW_QUERY_MS=1000          # log queries slower than this (ms)
# PG_CHECKPOINT_TARGET=0.9

# =============================================================================
# Auth (dashboard login + CLI login + run persistence)
# =============================================================================
TALON_ADMIN_USERNAME=admin
TALON_ADMIN_PASSWORD=change-me-to-a-real-password       # (required)
# TALON_AUTH_DISABLED=false      # dev escape hatch — NEVER true in prod

# =============================================================================
# LLM provider — pick ONE backend per role. See README + docs/slm-onnx.md.
#   LLM_PROVIDER:      bedrock (default) | ollama | openai | onnx
#   LLM_CODE_PROVIDER: optional override for codegen only
# =============================================================================
LLM_PROVIDER=bedrock
LLM_CODE_PROVIDER=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1000
TALON_RUN_TIMEOUT=20m
OPENAI_HTTP_TIMEOUT=120s

# ---- Ollama (LLM_PROVIDER=ollama) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MAIN_MODEL=talon
OLLAMA_JUDGE_MODEL=talon
OLLAMA_CODE_MODEL=talon
# OLLAMA_KEEP_ALIVE=5m
# OLLAMA_MAX_MODELS=1
# OLLAMA_NUM_PARALLEL=1

# ---- OpenAI-compatible (LLM_PROVIDER=openai) ----
# OpenAI, Azure OpenAI, z.ai/GLM, vLLM, LiteLLM, etc.
OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
OPENAI_API_KEY=                                # (required if provider=openai)
OPENAI_MAIN_MODEL=glm-5.2
OPENAI_JUDGE_MODEL=glm-5.2
OPENAI_CODE_MODEL=glm-5.2

# ---- ONNX / SmolLM SLM (LLM_PROVIDER=onnx) ----
# docker compose --profile slm up -d --build onnx-slm
ONNX_BASE_URL=http://localhost:8090/v1
ONNX_API_KEY=talon-local
ONNX_MAIN_MODEL=smollm
ONNX_JUDGE_MODEL=smollm
ONNX_CODE_MODEL=smollm
# SLM_MODEL_ID=HuggingFaceTB/SmolLM2-360M-Instruct
# SLM_BACKEND=auto          # auto | transformers | onnx
# SLM_PORT=8090

# ---- AWS Bedrock (LLM_PROVIDER=bedrock) ----
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# =============================================================================
# Caddy TLS reverse proxy (compose --profile proxy up -d caddy)
# =============================================================================
# TALON_DOMAIN=talon.example.com   # your domain for auto-HTTPS
# ACME_EMAIL=admin@example.com     # Let's Encrypt registration email

# =============================================================================
# Resource limits (override per-service memory/CPU caps)
# All values are Docker resource limits. Adjust to your host capacity.
# =============================================================================
# MSF_MEMORY_LIMIT=2g          MSF_CPU_LIMIT=2.0
# ARSENAL_MEMORY_LIMIT=4g      ARSENAL_CPU_LIMIT=3.0
# RABBITMQ_MEMORY_LIMIT=1g     RABBITMQ_CPU_LIMIT=1.5
# PG_MEMORY_LIMIT=1g           PG_CPU_LIMIT=1.5
# REDIS_MEMORY_LIMIT=256m      REDIS_CPU_LIMIT=0.5
# OLLAMA_MEMORY_LIMIT=8g       OLLAMA_CPU_LIMIT=4.0
# SLM_MEMORY_LIMIT=4g          SLM_CPU_LIMIT=3.0
# CORE_MEMORY_LIMIT=2g         CORE_CPU_LIMIT=2.0
# RELAY_MEMORY_LIMIT=2g        RELAY_CPU_LIMIT=2.0
# DASHBOARD_MEMORY_LIMIT=512m  DASHBOARD_CPU_LIMIT=1.0
# CADDY_MEMORY_LIMIT=256m      CADDY_CPU_LIMIT=0.5

# =============================================================================
# Logging
# =============================================================================
# LOG_MAX_SIZE=10m            # max log file size before rotation
# LOG_MAX_FILE=3              # number of rotated files to keep

# =============================================================================
# Operator CLI (optional, not used by compose)
# =============================================================================
# TALON_CORE_URL=http://localhost:8000
# TALON_PROJECT_DIR=.
# TALON_OUTPUT=table
# TALON_CONFIG=~/.config/talon/config.yaml

# =============================================================================
# Lab vuln target (compose --profile vuln)
# =============================================================================
# VULN_TARGET=real            # real (default) | mimic
# VULN_TARGET_IMAGE=talon-vuln-target
