{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "red",
      "2": "white"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  ›  ",
    "color": {
      "keys": "red",
      "title": "red",
      "output": "default",
      "separator": "red"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}"
    },
    {
      "type": "custom",
      "key": "Role",
      "format": "TALON // BLACKARCH ARSENAL"
    },
    "separator",
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Pkgs"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Term"
    },
    {
      "type": "cpu",
      "key": "CPU"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "disk",
      "folders": "/",
      "key": "Disk"
    },
    "break",
    {
      "type": "custom",
      "key": "API",
      "format": "http://127.0.0.1:8888/health"
    },
    {
      "type": "custom",
      "key": "Stack",
      "format": "BlackArch · ttyd · arsenal_engine · SSO"
    },
    {
      "type": "custom",
      "key": "Auth",
      "format": "authorized targets only"
    },
    "break",
    "colors"
  ]
}
